<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sms.system.mapper.SysDepartmentParentBindingMapper">
    
    <resultMap type="com.sms.system.entity.SysDepartmentParentBinding" id="SysDepartmentParentBindingResult">
        <result property="id" column="id"/>
        <result property="departmentId" column="department_id"/>
        <result property="parentUserId" column="parent_user_id"/>
        <result property="studentUserId" column="student_user_id"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <!-- 根據部門 ID 列表批量查詢家長綁定列表 -->
    <select id="selectByDepartmentIds" resultMap="SysDepartmentParentBindingResult">
        SELECT id, department_id, parent_user_id, student_user_id, create_time, update_time
        FROM sys_department_parent_binding
        WHERE department_id IN
        <foreach collection="departmentIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <!-- 根據學生用戶 ID 列表批量查詢家長綁定列表 -->
    <select id="selectByStudentUserIds" resultMap="SysDepartmentParentBindingResult">
        SELECT id, department_id, parent_user_id, student_user_id, create_time, update_time
        FROM sys_department_parent_binding
        WHERE student_user_id IN
        <foreach collection="studentUserIds" item="studentUserId" open="(" separator="," close=")">
            #{studentUserId}
        </foreach>
    </select>

    <!-- 根据家长用户ID和学生用户ID批量查询部门绑定关系 -->
    <select id="selectByParentAndStudentUserIds" resultMap="SysDepartmentParentBindingResult">
        SELECT id, department_id, parent_user_id, student_user_id, create_time, update_time
        FROM sys_department_parent_binding
        WHERE parent_user_id IN
        <foreach collection="parentUserIds" item="parentUserId" open="(" separator="," close=")">
            #{parentUserId}
        </foreach>
        AND student_user_id IN
        <foreach collection="studentUserIds" item="studentUserId" open="(" separator="," close=")">
            #{studentUserId}
        </foreach>
    </select>

    <select id="selectAllParentUserIds" resultType="java.lang.String">
        SELECT DISTINCT parent_user_id
        FROM sys_department_parent_binding
        WHERE parent_user_id IS NOT NULL AND parent_user_id != ''
    </select>

    <select id="selectByDepartmentId" resultMap="SysDepartmentParentBindingResult">
        SELECT id, department_id, parent_user_id, student_user_id, create_time, update_time
        FROM sys_department_parent_binding
        WHERE department_id = #{departmentId}
    </select>

    <insert id="insertIgnore" parameterType="com.sms.system.entity.SysDepartmentParentBinding" useGeneratedKeys="true" keyProperty="id">
        INSERT IGNORE INTO sys_department_parent_binding
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="departmentId != null">department_id,</if>
            <if test="parentUserId != null">parent_user_id,</if>
            <if test="studentUserId != null">student_user_id,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="departmentId != null">#{departmentId},</if>
            <if test="parentUserId != null">#{parentUserId},</if>
            <if test="studentUserId != null">#{studentUserId},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <update id="updateById" parameterType="com.sms.system.entity.SysDepartmentParentBinding">
        UPDATE sys_department_parent_binding
        <set>
            <if test="departmentId != null">department_id = #{departmentId},</if>
            <if test="parentUserId != null">parent_user_id = #{parentUserId},</if>
            <if test="studentUserId != null">student_user_id = #{studentUserId},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM sys_department_parent_binding WHERE id = #{id}
    </delete>

</mapper>
