<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sms.system.mapper.SysParentStudentRelationMapper">
    
    <resultMap type="com.sms.system.entity.SysParentStudentRelation" id="SysParentStudentRelationResult">
        <result property="id" column="id"/>
        <result property="parentUserId" column="parent_user_id"/>
        <result property="studentUserId" column="student_user_id"/>
        <result property="studentName" column="student_name"/>
        <result property="relationDesc" column="relation_desc"/>
        <result property="mobile" column="mobile"/>
        <result property="externalUserid" column="external_userid"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <!-- 批量查詢家長學生關係 -->
    <select id="selectByParentUserIds" resultMap="SysParentStudentRelationResult">
        SELECT id, parent_user_id, student_user_id, student_name, relation_desc, mobile, external_userid, create_time, update_time
        FROM sys_parent_student_relation
        WHERE parent_user_id IN
        <foreach collection="parentUserIds" item="parentUserId" open="(" separator="," close=")">
            #{parentUserId}
        </foreach>
    </select>

    <select id="selectByIds" resultMap="SysParentStudentRelationResult">
        SELECT id, parent_user_id, student_user_id, student_name, relation_desc, mobile, external_userid, create_time, update_time
        FROM sys_parent_student_relation
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <!-- 根據家長用戶ID和學生用戶ID批量查詢家長學生關係 -->
    <select id="selectByParentAndStudentUserIds" resultMap="SysParentStudentRelationResult">
        SELECT id, parent_user_id, student_user_id, student_name, relation_desc, mobile, external_userid, create_time, update_time
        FROM sys_parent_student_relation
        WHERE parent_user_id IN
        <foreach collection="parentUserIds" item="parentUserId" open="(" separator="," close=")">
            #{parentUserId}
        </foreach>
        AND student_user_id IN
        <foreach collection="studentUserIds" item="studentUserId" open="(" separator="," close=")">
            #{studentUserId}
        </foreach>
    </select>

    <insert id="insertIgnore" parameterType="com.sms.system.entity.SysParentStudentRelation" useGeneratedKeys="true" keyProperty="id">
        INSERT IGNORE INTO sys_parent_student_relation
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="parentUserId != null">parent_user_id,</if>
            <if test="studentUserId != null">student_user_id,</if>
            <if test="studentName != null">student_name,</if>
            <if test="relationDesc != null">relation_desc,</if>
            <if test="mobile != null">mobile,</if>
            <if test="externalUserid != null">external_userid,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="parentUserId != null">#{parentUserId},</if>
            <if test="studentUserId != null">#{studentUserId},</if>
            <if test="studentName != null">#{studentName},</if>
            <if test="relationDesc != null">#{relationDesc},</if>
            <if test="mobile != null">#{mobile},</if>
            <if test="externalUserid != null">#{externalUserid},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

</mapper>
