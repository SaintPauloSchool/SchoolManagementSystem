<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sms.system.mapper.SysTokenMapper">

    <resultMap id="SysTokenResult" type="com.sms.system.entity.SysToken">
        <id     property="id"           column="id"/>
        <result property="userId"       column="user_id"/>
        <result property="userType"     column="user_type"/>
        <result property="token"        column="token"/>
        <result property="expireTime"   column="expire_time"/>
        <result property="createTime"   column="create_time"/>
        <result property="updateTime"   column="update_time"/>
    </resultMap>

    <!-- 根據 Token 值查詢記錄 -->
    <select id="selectByToken" resultMap="SysTokenResult">
        SELECT id, user_id, user_type, token, expire_time, create_time, update_time
        FROM sys_token
        WHERE token = #{token}
        LIMIT 1
    </select>

</mapper>
