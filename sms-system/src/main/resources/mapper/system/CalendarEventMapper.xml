<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sms.system.mapper.CalendarEventMapper">
    
    <resultMap type="com.sms.system.entity.CalendarEvent" id="CalendarEventResult">
        <result property="eventId"    column="event_id"    />
        <result property="eventDate"  column="event_date"  />
        <result property="title"      column="title"       />
        <result property="targetType" column="target_type" />
        <result property="createBy"   column="create_by"   />
        <result property="createTime" column="create_time" />
        <result property="updateBy"   column="update_by"   />
        <result property="updateTime" column="update_time" />
        <result property="remark"     column="remark"      />
    </resultMap>

    <sql id="selectCalendarEventVo">
        select event_id, event_date, title, target_type, create_by, create_time, update_by, update_time, remark from calendar_event
    </sql>

    <select id="selectCalendarEventList" parameterType="com.sms.system.entity.CalendarEvent" resultMap="CalendarEventResult">
        <include refid="selectCalendarEventVo"/>
        <where>  
            <if test="eventDate != null "> and event_date = #{eventDate}</if>
            <if test="title != null  and title != ''"> and title like concat('%', #{title}, '%')</if>
            <if test="targetType != null "> and target_type = #{targetType}</if>
        </where>
        order by event_date desc, target_type asc
    </select>
    
    <select id="selectCalendarEventByEventId" parameterType="Long" resultMap="CalendarEventResult">
        <include refid="selectCalendarEventVo"/>
        where event_id = #{eventId}
    </select>
        
    <insert id="insertCalendarEvent" parameterType="com.sms.system.entity.CalendarEvent" useGeneratedKeys="true" keyProperty="eventId">
        insert into calendar_event
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="eventDate != null">event_date,</if>
            <if test="title != null and title != ''">title,</if>
            <if test="targetType != null">target_type,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="eventDate != null">#{eventDate},</if>
            <if test="title != null and title != ''">#{title},</if>
            <if test="targetType != null">#{targetType},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>
    
    <insert id="insertCalendarEventBatch" parameterType="java.util.List">
        insert into calendar_event (event_date, title, target_type, create_by, create_time, remark)
        values
        <foreach collection="list" item="item" index="index" separator=",">
            (#{item.eventDate}, #{item.title}, #{item.targetType}, #{item.createBy}, #{item.createTime}, #{item.remark})
        </foreach>
    </insert>

    <update id="updateCalendarEvent" parameterType="com.sms.system.entity.CalendarEvent">
        update calendar_event
        <trim prefix="SET" suffixOverrides=",">
            <if test="eventDate != null">event_date = #{eventDate},</if>
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="targetType != null">target_type = #{targetType},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where event_id = #{eventId}
    </update>

    <delete id="deleteCalendarEventByEventId" parameterType="Long">
        delete from calendar_event where event_id = #{eventId}
    </delete>

    <delete id="deleteCalendarEventByEventIds" parameterType="Long">
        delete from calendar_event where event_id in 
        <foreach item="eventId" collection="eventIds" open="(" separator="," close=")">
            #{eventId}
        </foreach>
    </delete>
</mapper>
