<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sms.system.mapper.WecomMemberAccountMapper">

    <resultMap id="WecomMemberAccountResult" type="com.sms.system.entity.WecomMemberAccount">
        <id     property="id"           column="id"/>
        <result property="userid"       column="userid"/>
        <result property="username"     column="username"/>
        <result property="password"     column="password"/>
        <result property="salt"         column="salt"/>
        <result property="status"       column="status"/>
        <result property="createTime"   column="create_time"/>
        <result property="updateTime"   column="update_time"/>
    </resultMap>

    <sql id="selectAccountVo">
        select id, userid, username, password, salt, status, create_time, update_time
        from wecom_member_account
    </sql>

    <select id="selectByUserId" resultMap="WecomMemberAccountResult">
        <include refid="selectAccountVo"/>
        where userid = #{userid}
        limit 1
    </select>

    <select id="selectByUsername" resultMap="WecomMemberAccountResult">
        <include refid="selectAccountVo"/>
        where username = #{username}
        limit 1
    </select>

    <insert id="insert" parameterType="com.sms.system.entity.WecomMemberAccount" useGeneratedKeys="true" keyProperty="id">
        insert into wecom_member_account (
            userid,
            username,
            password,
            salt,
            status,
            create_time,
            update_time
        ) values (
            #{userid},
            #{username},
            #{password},
            #{salt},
            #{status},
            sysdate(),
            sysdate()
        )
    </insert>

    <update id="update" parameterType="com.sms.system.entity.WecomMemberAccount">
        update wecom_member_account
        <set>
            <if test="username != null and username != ''">username = #{username},</if>
            <if test="password != null and password != ''">password = #{password},</if>
            <if test="salt != null and salt != ''">salt = #{salt},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            update_time = sysdate()
        </set>
        where userid = #{userid}
    </update>

</mapper>
