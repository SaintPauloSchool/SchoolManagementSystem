<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sms.system.mapper.SysTaskLogMapper">
    
    <resultMap type="com.sms.system.entity.SysTaskLog" id="SysTaskLogResult">
        <id     property="logId"          column="log_id"           />
        <result property="taskName"       column="task_name"        />
        <result property="beanName"       column="bean_name"        />
        <result property="methodName"     column="method_name"      />
        <result property="status"         column="status"           />
        <result property="isProcessed"    column="is_processed"     />
        <result property="failReason"     column="fail_reason"      />
        <result property="successCount"   column="success_count"    />
        <result property="failCount"      column="fail_count"       />
        <result property="executionTime"  column="execution_time"   />
        <result property="duration"       column="duration"         />
        <result property="createTime"     column="create_time"      />
    </resultMap>

    <sql id="selectSysTaskLogVo">
        select log_id, task_name, bean_name, method_name, status, is_processed, fail_reason, success_count, fail_count, execution_time, duration, create_time
        from sys_task_log
    </sql>

    <select id="selectTaskLogList" parameterType="com.sms.system.entity.SysTaskLog" resultMap="SysTaskLogResult">
        <include refid="selectSysTaskLogVo"/>
        <where>  
            <if test="taskName != null and taskName != ''"> and task_name like concat('%', #{taskName}, '%')</if>
            <if test="status != null and status != ''"> and status = #{status}</if>
            <if test="beginTime != null and beginTime != ''"><!-- 開始時間檢索 -->
                and execution_time &gt;= #{beginTime}
            </if>
            <if test="endTime != null and endTime != ''"><!-- 結束時間檢索 -->
                and execution_time &lt;= #{endTime}
            </if>
        </where>
        order by execution_time desc
    </select>
    
    <insert id="insertTaskLog" parameterType="com.sms.system.entity.SysTaskLog" useGeneratedKeys="true" keyProperty="logId">
        insert into sys_task_log
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="taskName != null and taskName != ''">task_name,</if>
            <if test="beanName != null and beanName != ''">bean_name,</if>
            <if test="methodName != null and methodName != ''">method_name,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="isProcessed != null and isProcessed != ''">is_processed,</if>
            <if test="failReason != null">fail_reason,</if>
            <if test="successCount != null">success_count,</if>
            <if test="failCount != null">fail_count,</if>
            <if test="executionTime != null">execution_time,</if>
            <if test="duration != null">duration,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="taskName != null and taskName != ''">#{taskName},</if>
            <if test="beanName != null and beanName != ''">#{beanName},</if>
            <if test="methodName != null and methodName != ''">#{methodName},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="isProcessed != null and isProcessed != ''">#{isProcessed},</if>
            <if test="failReason != null">#{failReason},</if>
            <if test="successCount != null">#{successCount},</if>
            <if test="failCount != null">#{failCount},</if>
            <if test="executionTime != null">#{executionTime},</if>
            <if test="duration != null">#{duration},</if>
            sysdate()
        </trim>
    </insert>

    <update id="updateTaskLog" parameterType="com.sms.system.entity.SysTaskLog">
        update sys_task_log
        <trim prefix="SET" suffixOverrides=",">
            <if test="isProcessed != null and isProcessed != ''">is_processed = #{isProcessed},</if>
        </trim>
        where log_id = #{logId}
    </update>

    <select id="countFailedUnprocessedTasks" resultType="int">
        SELECT COUNT(1)
        FROM sys_task_log
        WHERE (status = '1' OR status = '2') AND is_processed = '0'
    </select>

</mapper>
