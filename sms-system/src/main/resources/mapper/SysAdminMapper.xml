<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sms.system.mapper.SysAdminMapper">

    <resultMap type="SysAdmin" id="SysAdminResult">
        <result property="id"          column="id"          />
        <result property="userId"      column="user_id"     />
        <result property="adminName"   column="admin_name"  />
        <result property="type"        column="type"        />
        <result property="status"      column="status"      />
        <result property="createTime"  column="create_time" />
        <result property="updateTime"  column="update_time" />
        <result property="remark"      column="remark"      />
    </resultMap>

    <sql id="selectAdminVo">
        SELECT id, user_id, admin_name, type, status, create_time, update_time, remark
        FROM sys_admin
    </sql>

    <select id="selectByUserId" resultMap="SysAdminResult">
        <include refid="selectAdminVo"/>
        WHERE user_id = #{userId}
    </select>

    <select id="selectById" resultMap="SysAdminResult">
        <include refid="selectAdminVo"/>
        WHERE id = #{id}
    </select>

    <select id="selectAdminUserIds" resultType="java.lang.String">
        SELECT user_id
        FROM sys_admin
        WHERE status = '0'
    </select>

    <select id="selectList" parameterType="com.sms.system.entity.dto.SysAdminQueryDTO" resultMap="SysAdminResult">
        <include refid="selectAdminVo"/>
        <where>
            <if test="adminName != null and adminName != ''">
                AND admin_name LIKE CONCAT('%', #{adminName}, '%')
            </if>
            <if test="userId != null and userId != ''">
                AND user_id LIKE CONCAT('%', #{userId}, '%')
            </if>
            <if test="type != null and type != ''">
                AND type = #{type}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
        ORDER BY type ASC, id ASC
    </select>

    <select id="countByTypeAndStatus" resultType="int">
        SELECT COUNT(1)
        FROM sys_admin
        WHERE type = #{type}
          AND status = #{status}
    </select>

    <insert id="insert" parameterType="SysAdmin" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_admin (
            user_id,
            admin_name,
            type,
            status,
            create_time,
            update_time,
            remark
        ) VALUES (
            #{userId},
            #{adminName},
            #{type},
            #{status},
            #{createTime},
            #{updateTime},
            #{remark}
        )
    </insert>

    <update id="updateById" parameterType="SysAdmin">
        UPDATE sys_admin
        <set>
            <if test="adminName != null and adminName != ''">admin_name = #{adminName},</if>
            <if test="type != null and type != ''">type = #{type},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = #{updateTime}
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM sys_admin WHERE id = #{id}
    </delete>

    <delete id="deleteByIds">
        DELETE FROM sys_admin WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
