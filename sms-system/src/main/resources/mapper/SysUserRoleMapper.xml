<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sms.system.mapper.SysUserRoleMapper">

    <resultMap type="SysUserRole" id="SysUserRoleResult">
        <result property="id"                 column="id"                   />
        <result property="userId"             column="user_id"              />
        <result property="userName"            column="admin_name"           />
        <result property="senderDisplayName"  column="sender_display_name"  />
        <result property="type"               column="type"                 />
        <result property="status"             column="status"               />
        <result property="createTime"         column="create_time"          />
        <result property="updateTime"         column="update_time"          />
        <result property="remark"             column="remark"               />
    </resultMap>

    <sql id="selectUserRoleVo">
        SELECT id, user_id, admin_name, sender_display_name, type, status, create_time, update_time, remark
        FROM sys_user_role
    </sql>

    <select id="selectByUserId" resultMap="SysUserRoleResult">
        <include refid="selectUserRoleVo"/>
        WHERE user_id = #{userId}
    </select>

    <select id="selectById" resultMap="SysUserRoleResult">
        <include refid="selectUserRoleVo"/>
        WHERE id = #{id}
    </select>

    <select id="selectActiveUserIds" resultType="java.lang.String">
        SELECT user_id
        FROM sys_user_role
        WHERE status = '0'
          AND type IN ('0', '1')
    </select>

    <select id="selectList" parameterType="com.sms.system.entity.dto.SysUserRoleQueryDTO" resultMap="SysUserRoleResult">
        <include refid="selectUserRoleVo"/>
        <where>
            <if test="userName != null and userName != ''">
                AND admin_name LIKE CONCAT('%', #{userName}, '%')
            </if>
            <if test="userId != null and userId != ''">
                AND user_id LIKE CONCAT('%', #{userId}, '%')
            </if>
            <if test="type != null and type != ''">
                AND type = #{type}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
        ORDER BY type ASC, id ASC
    </select>

    <select id="countByTypeAndStatus" resultType="int">
        SELECT COUNT(1)
        FROM sys_user_role
        WHERE type = #{type}
          AND status = #{status}
    </select>

    <insert id="insert" parameterType="SysUserRole" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_user_role (
            user_id,
            admin_name,
            sender_display_name,
            type,
            status,
            create_time,
            update_time,
            remark
        ) VALUES (
            #{userId},
            #{userName},
            #{senderDisplayName},
            #{type},
            #{status},
            #{createTime},
            #{updateTime},
            #{remark}
        )
    </insert>

    <update id="updateById" parameterType="SysUserRole">
        UPDATE sys_user_role
        <set>
            <if test="userName != null and userName != ''">admin_name = #{userName},</if>
            <if test="senderDisplayName != null">sender_display_name = #{senderDisplayName},</if>
            <if test="type != null and type != ''">type = #{type},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = #{updateTime}
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM sys_user_role WHERE id = #{id}
    </delete>

    <delete id="deleteByIds">
        DELETE FROM sys_user_role WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
